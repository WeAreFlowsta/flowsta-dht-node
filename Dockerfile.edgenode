# Flowsta edge node base image: Holo Host's edge node with the conductor
# binary overlaid from the official Holochain release.
#
# Holo Host's published edge node image bundles a release candidate and
# their main branch tracks its own schedule. Rather than run what they ship,
# we take their image as a base and overlay the conductor + hc binaries from
# the official holochain-<version> GitHub release. Everything else in the
# image (s6 supervision, config templating, log rotation) is Holo Host's.
#
# Two lines are built from this file during the 0.6 -> 0.7 transition:
#   HOLOCHAIN_VERSION=0.6.1  -> flowsta-edgenode:hc0.6.1 (the digest the fleet runs today)
#   HOLOCHAIN_VERSION=0.7.1  -> flowsta-edgenode:hc0.7.1
#
# Build:  gcloud builds submit --config=cloudbuild-edgenode.yaml \
#           --substitutions=_HOLOCHAIN_VERSION=0.7.1 --project=flowsta-475001
# Output: us-docker.pkg.dev/flowsta-475001/public/flowsta-edgenode:hc<version>
#         (the node manifest pins the image by the digest Cloud Build prints)
#
# Consumed by: every Flowsta conductor (fleet, API hosts, community nodes).

# Base pinned by digest = ghcr.io/holo-host/edgenode:v0.2.0-alpha1 (= :latest
# as of 2026-05). Digest pin so the base can't drift under us.
FROM ghcr.io/holo-host/edgenode@sha256:bd6336f1a2a4ce47b819123e1ef84353cfc7357df5e1832ea59aba8ab77904d3

USER root

# x86_64 only — every Flowsta conductor (fleet
# and production) runs on an amd64 GCP VM.
ARG HOLOCHAIN_VERSION=0.6.1
ARG HC_ARCH=x86_64-unknown-linux-gnu

# Overlay the stable conductor + hc CLI over the base image's rc.3 binaries.
# The trailing `holochain --version` is a build-time sanity check — a wrong
# arch or a truncated download fails the build loudly here.
RUN wget -q "https://github.com/holochain/holochain/releases/download/holochain-${HOLOCHAIN_VERSION}/holochain-${HC_ARCH}" -O /bin/holochain \
 && wget -q "https://github.com/holochain/holochain/releases/download/holochain-${HOLOCHAIN_VERSION}/hc-${HC_ARCH}" -O /bin/hc \
 && chmod +x /bin/holochain /bin/hc \
 && /bin/holochain --version

# The upstream entrypoint insists on admin port 4444. Two conductors share a
# host during a Holochain line transition, so each runs on its own admin
# port; the check becomes "an admin port is configured". The template is
# still copied to /etc/holochain/conductor-config.yaml on every start, so
# whoever runs the container supplies the config (the node agent renders it
# from the signed manifest).
# In this base the check is the s6 setup script; older bases kept it in an
# entrypoint script. Patch every copy present and prove one was patched.
RUN for f in /etc/s6-overlay/s6-rc.d/setup/init.sh /usr/local/bin/entrypoint.sh /entrypoint.sh; do \
      [ -f "$f" ] && sed -i 's/grep -q "port: 4444"/grep -Eq "port: [0-9]+"/' "$f"; \
    done; \
    grep -l 'grep -Eq "port: \[0-9\]+"' /etc/s6-overlay/s6-rc.d/setup/init.sh /usr/local/bin/entrypoint.sh /entrypoint.sh 2>/dev/null | grep -q . \
 && ! grep -rq 'port: 4444' /etc/s6-overlay/s6-rc.d/setup/init.sh

LABEL org.flowsta.base="ghcr.io/holo-host/edgenode@sha256:bd6336f1a2a4ce47b819123e1ef84353cfc7357df5e1832ea59aba8ab77904d3" \
      org.flowsta.holochain-version="${HOLOCHAIN_VERSION}"
